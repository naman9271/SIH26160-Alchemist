# Copy this file to .env for Docker Compose. Never commit the real .env.

# Public URL opened by users. Change this after assigning an Azure/custom domain.
APP_PUBLIC_URL=http://localhost:3000

# Host ports used only by the local Docker Compose deployment.
FRONTEND_BIND_HOST=0.0.0.0
CORE_BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
CORE_HTTP_PORT=8080
CORE_GRPC_PORT=50052

# Private container-to-container endpoints. Do not use localhost in containers.
CORE_HTTP_URL=http://backend:8080
ML_GRPC_ADDRESS=ml:50051
CORE_HTTP_ADDRESS=0.0.0.0:8080
CORE_GRPC_ADDRESS=0.0.0.0:50052
ML_GRPC_HOST=0.0.0.0
ML_GRPC_PORT=50051

# Comma-separated browser origins allowed to call Core directly.
# The normal dashboard uses its same-origin /api/core proxy, but keeping this
# exact allowlist supports a separately hosted browser frontend when required.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Disposition,Content-Type
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Persistent report artifact directory inside the Core container.
REPORT_TEMP_DIRECTORY=/var/lib/alchemist/reports

# Optional report-chat integration. Leave blank to disable it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
