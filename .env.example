# Copy this file to .env for Docker Compose. Never commit the real .env.

# Copy to .env on the VM. Do not commit the real file.

# The Vercel frontend is the only browser origin permitted to call the API.
CORS_ALLOWED_ORIGINS=https://alchemist160.vercel.app
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Disposition,Content-Type
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Private container-to-container endpoints. Do not use localhost in containers.
ML_GRPC_ADDRESS=ml:50051
ML_GRPC_HOST=0.0.0.0
ML_GRPC_PORT=50051

# Vercel's server-side proxy reaches this public HTTP port. Do not publish the
# gRPC or ML ports.
CORE_BIND_HOST=0.0.0.0
CORE_HTTP_PORT=8080
