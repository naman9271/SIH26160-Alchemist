# Export these values before running Core directly, or configure them in Azure.
CORE_HTTP_ADDRESS=0.0.0.0:8080
CORE_GRPC_ADDRESS=0.0.0.0:50052
ML_GRPC_ADDRESS=127.0.0.1:50051
REPORT_TEMP_DIRECTORY=/var/lib/alchemist/reports

# Replace with the exact deployed frontend URL. Separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Disposition,Content-Type
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Optional live StrongSwan / Linux assessment settings.
VICI_SOCKET_URI=unix:///var/run/charon.vici
VICI_FIXTURE_PATH=
XFRM_FIXTURE_PATH=
