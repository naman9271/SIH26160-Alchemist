# Server-only Core URL used by the same-origin /api/core proxy in local development.
CORE_HTTP_URL=http://127.0.0.1:8080

# Set this in Vercel to the public HTTPS Azure API, for example
# https://api.example.com. It is intentionally public (not a secret) and sends
# browser uploads directly to Core instead of through a Vercel function.
NEXT_PUBLIC_CORE_HTTP_URL=

# Public dashboard URL used for canonical metadata. This is intentionally
# server-only so one built image can be promoted between environments.
APP_PUBLIC_URL=http://localhost:3000

# Optional report-chat integration. Never prefix secrets with NEXT_PUBLIC_.
# Add these in Vercel, then redeploy the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
